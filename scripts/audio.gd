extends Node
## Plays sound effects, looping ambience and region music.
## All sounds live in res://assets/audio/ (generated by tools/make_audio.py).

const DIR := "res://assets/audio/"
const FADE := 2.5

var music_volume := 0.7
var sound_volume := 1.0

var _streams := {}
var _pool: Array = []
var _pool3d: Array = []
var _music: Array = []  # two players, cross-faded
var _music_key := ""
var _music_i := 0
var _amb: Array = []
var _amb_key := ""
var _amb_i := 0
var _loops := {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for bus in ["Music", "Sound"]:
		if AudioServer.get_bus_index(bus) == -1:
			AudioServer.add_bus()
			var i := AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, bus)
			AudioServer.set_bus_send(i, "Master")
	for i in 14:
		var p := AudioStreamPlayer.new()
		p.bus = "Sound"
		add_child(p)
		_pool.append(p)
	for i in 10:
		var p3 := AudioStreamPlayer3D.new()
		p3.bus = "Sound"
		p3.unit_size = 5.0
		p3.max_distance = 34.0
		add_child(p3)
		_pool3d.append(p3)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.bus = "Music"
		m.volume_db = -80.0
		add_child(m)
		_music.append(m)
		var a := AudioStreamPlayer.new()
		a.bus = "Sound"
		a.volume_db = -80.0
		add_child(a)
		_amb.append(a)
	set_music_volume(music_volume)
	set_sound_volume(sound_volume)


func stream(sound: String, loop := false) -> AudioStream:
	if _streams.has(sound):
		return _streams[sound]
	var path := DIR + sound + ".ogg"
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path)
		if loop and s is AudioStreamOggVorbis:
			(s as AudioStreamOggVorbis).loop = true
	else:
		push_warning("Missing sound: " + path)
	_streams[sound] = s
	return s


func _free_player(pool: Array):
	for p in pool:
		if not p.playing:
			return p
	return pool[0]


## Plays a sound effect. pitch_var adds a little random pitch so repeats
## don't sound mechanical.
func play(sound: String, volume_db := 0.0, pitch_var := 0.06) -> void:
	var s := stream(sound)
	if s == null:
		return
	var p: AudioStreamPlayer = _free_player(_pool)
	_pool.erase(p)
	_pool.append(p)
	p.stream = s
	p.volume_db = volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_var, pitch_var)
	p.play()


## Plays a sound at a place in the world (it gets quieter with distance).
func play_at(sound: String, at: Vector3, volume_db := 0.0, pitch_var := 0.08) -> void:
	var s := stream(sound)
	if s == null:
		return
	var p: AudioStreamPlayer3D = _free_player(_pool3d)
	_pool3d.erase(p)
	_pool3d.append(p)
	p.stream = s
	p.global_position = at
	p.volume_db = volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_var, pitch_var)
	p.play()


## Cross-fades to a region's music ("" for silence).
func play_music(key: String) -> void:
	if key == _music_key:
		return
	_music_key = key
	_music_i = _crossfade(_music, _music_i, "music_" + key if key != "" else "", -4.0)


## Cross-fades to a looping ambience ("" for silence).
func play_ambience(key: String) -> void:
	if key == _amb_key:
		return
	_amb_key = key
	_amb_i = _crossfade(_amb, _amb_i, "amb_" + key if key != "" else "", -8.0)


func _crossfade(players: Array, cur: int, sound: String, level_db: float) -> int:
	var old: AudioStreamPlayer = players[cur]
	var nxt := 1 - cur
	var tw := create_tween()
	tw.tween_property(old, "volume_db", -80.0, FADE)
	tw.tween_callback(old.stop)
	if sound == "":
		return cur
	var s := stream(sound, true)
	if s == null:
		return cur
	var np: AudioStreamPlayer = players[nxt]
	np.stream = s
	np.volume_db = -40.0
	np.play()
	var tw2 := create_tween()
	tw2.tween_property(np, "volume_db", level_db, FADE)
	return nxt


## Keeps a looping sound (glide wind, vent rush) at a volume from 0 to 1.
func set_loop(sound: String, level: float) -> void:
	var p: AudioStreamPlayer = _loops.get(sound)
	if p == null:
		if level <= 0.01:
			return
		p = AudioStreamPlayer.new()
		p.bus = "Sound"
		p.stream = stream(sound, true)
		add_child(p)
		_loops[sound] = p
	if level <= 0.01:
		if p.playing:
			p.stop()
		return
	p.volume_db = linear_to_db(clampf(level, 0.0, 1.0))
	if not p.playing:
		p.play()


func set_music_volume(v: float) -> void:
	music_volume = v
	var i := AudioServer.get_bus_index("Music")
	AudioServer.set_bus_volume_db(i, linear_to_db(maxf(v, 0.0001)))
	AudioServer.set_bus_mute(i, v <= 0.001)


func set_sound_volume(v: float) -> void:
	sound_volume = v
	var i := AudioServer.get_bus_index("Sound")
	AudioServer.set_bus_volume_db(i, linear_to_db(maxf(v, 0.0001)))
	AudioServer.set_bus_mute(i, v <= 0.001)
